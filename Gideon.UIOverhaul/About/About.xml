<?xml version="1.0" encoding="UTF-8"?>
<ModMetaData>
  <name>Gideon's UI Overhaul</name>
  <author>Gideon</author>
  <packageId>gideon.uioverhaul</packageId>
  <modVersion>1.6.4871.14109</modVersion>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <url></url>
  <description>
    A modern overhaul for RimWorld's UI.  Supports themes and has a framework API for other mods to implement custom UI elements with.

    Includes the architect tab consolidation that used to ship separately as Gideon's Clean Architect Tabs.  Unsubscribe from that mod if you have it: the two define the same categories and cannot both be loaded.
  </description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/Harmony/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <incompatibleWith>
    <li>falconne.LabelsOnFloor</li> <!-- Duplicate features -->
    <li>ferny.betterarchitect</li> <!-- Duplicate features -->
    <li>dubwise.dubsmintmenus</li> <!-- Duplicate features -->
    <li>Gideon.CleanArchitect</li> <!-- Duplicate features -->
  </incompatibleWith>
  <loadAfter>
    <!-- Storage mods we unify -->
    <li>adaptive.storage.framework</li>
    <li>adaptive.primitivestorage</li>
    <li>adaptive.simplestorage</li>
    <li>danifox.adaptiveoldsimplestorage</li>
    <li>asf.deepstorage</li>
    <li>reel.expanded.storage</li>
    <li>lwm.deepstorage</li>
    <li>ketaros.cratestorages</li>
    <li>eeg.moxasf</li>
    <li>dankpyon.medieval.overhaul</li>
    <li>silkcircuit.multimaplinkedstorage</li>
    <li>gideon.simplestorage</li>

    <!-- Gravship and Odyssey content mods, for the same reason, feeding the Space category. -->
    <li>als.gravtech</li>
    <li>als.anomalygravship</li>
    <li>mrhydralisk.complementaryodyssey</li>
  </loadAfter>
</ModMetaData>
