<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===========================================================================================
       Color palettes for the UI framework.

       Every role has a built-in default in code, so a palette only names the roles it wants to
       change. Anything left out is inherited from ParentName, and anything neither named nor
       inherited falls back to the compiled-in value.

       The element name is fully qualified. The short form <UIColorPaletteDef> also works, but the
       qualified name cannot be made ambiguous by another mod defining a type with the same name.

       Full documentation: Help/UIColorPaletteDef.md
       =========================================================================================== -->

  <!-- Template. Abstract, so it never becomes a palette of its own; it exists to be inherited.
       It holds what every theme should agree on: the meaning-carrying state colors, and the accent
       that gives the suite its identity. Surfaces and text belong to the individual themes, because
       those are exactly what a light or dark variant has to change. -->
  <Gideon.UIFramework.Defs.UIColorPaletteDef Abstract="True" Name="UIPaletteBase">
    <success>#61C461</success>
    <warning>#CCA633</warning>
    <danger>#E54D33</danger>
    <info>#4A90D9</info>
    <accent>#73BFFF</accent>
    <mood>#9B72D9</mood>  <!-- Mood Bar color -->

    <!-- The Dead tab draws its title, glyph and rail selection in this. The first tab with a color of
         its own; set it to accent to put that tab back in step with the rest. -->
    <tabTheDead>#A98FC8</tabTheDead>
    <tabQuests>#7FA3C9</tabQuests>
    <tabAnimals>#98AC80</tabAnimals>
    <tabPower>#74AFA6</tabPower>
    <tabGrowing>#C0AE6A</tabGrowing>
    <tabBills>#C4907A</tabBills>
    <tabPawns>#C98BA4</tabPawns>
    <tabHospital>#CC8BC7</tabHospital>

    <!-- The ninth identity, and the one that picked from the fullest ring: eight tabs already placed and
         twelve theme bands on the canvas underneath it. The widest gap left is a jade around 130, and it is
         wrong, because success is at 120 and this is the tab that spends success green on the word Done.
         So the next gap takes it, an iris at 235 between the quests blue and the violet of the dead. -->
    <tabResearch>#8B90CC</tabResearch>

    <!-- The tenth, and it takes the arc research turned down above, at 145 rather than 130: twenty five
         degrees off success and twenty seven off the power teal. It can, because its own scale draws the
         resting band in secondary text rather than in this, so the identity never lands beside the green
         that means Ally. -->
    <tabFactions>#65B486</tabFactions>

    <!-- The eleventh, and the last one the ring has room for. It was drawn at 145 too, independently, and
         moved when factions got there first. 190 is eighteen degrees off the power teal and nineteen off
         the quests blue, which is tighter than anything above; it is taken anyway because the purple arc
         is nineteen off mood, which this tab plots as a whole graph, and the citron is eighteen off
         warning. Cool also puts it as far as the wheel allows from its own chart series, which are gold. -->
    <tabHistory>#72B3C0</tabHistory>

    <!-- The mods screen, which is a page reached from the main menu rather than a colony tab. Shares the
         research indigo on purpose: the hue circle is full, and these two are the one pair that can never
         be on screen together, since reaching this page means no colony is loaded. -->
    <pageMods>#8F96C9</pageMods>

    <!-- The twelfth, added after history had already called itself the last one the ring has room for,
         which was true of hues and not of the wheel. This was drawn at 190 first and moved: history is
         there at 41 percent saturation and the two were the same colour at a glance, light theme
         included. There is no arc left, so this one is not on an arc. It is a warm pewter at 29 degrees
         carrying 31 points of chroma, against the 44 to 86 every other identity carries, sitting between
         the bills clay at 18 and the growing wheat at 47 and telling itself apart from both by being a
         third as coloured. That is the tabGrowing and warning trick at a wider margin.

         Warm rather than cold on purpose, and not only because cold was taken. The whole grey ramp in
         this palette, from textSecondary down to controlBackgroundFaded, sits at 216 degrees, so a cool
         near neutral is the one thing that could be confused with the text beside it. And a mech is
         unpainted metal: the only colour control on RimWorld's own mech tab is a button asking the
         player to pick one, because mechs do not have one. -->
    <tabMechs>#CCBCAD</tabMechs>
  </Gideon.UIFramework.Defs.UIColorPaletteDef>


  <!-- Dark Theme. This defName is not arbitrary: UIColorPaletteDef.DefaultPaletteDefName hardcodes
       it, so this def is what the framework uses until the player picks something else. -->
  <Gideon.UIFramework.Defs.UIColorPaletteDef ParentName="UIPaletteBase">
    <defName>UIPalette_Default</defName>
    <label>Modern Dark</label>
    <description>The default dark theme. Deep neutral surfaces with a cool blue accent.</description>

    <windowBackground>#15191D</windowBackground>
    <panelBackground>#1B1F23</panelBackground>
    <surfaceRaised>#15191D</surfaceRaised>
    <surfaceSunken>#0E1013</surfaceSunken>

    <border>#2F3337</border>
    <borderFocused>#73BFFF</borderFocused>

    <textPrimary>#E3E3E3</textPrimary>
    <textSecondary>#9EA6B2</textSecondary>
    <textDisabled>#6C7480</textDisabled>

    <accentMuted>#274157</accentMuted>

    <!-- The body of a control holding no value: an off toggle, an unselected radio button. Set well clear
         of panelBackground above it, or the control has no visible extent; note that surfaceRaised is
         darker than the panel in this theme, which is right for a card and wrong for a control. Keep it
         well clear of textSecondary too, since that is the toggle knob sitting on top of it. -->
    <controlBackgroundFaded>#434A53</controlBackgroundFaded>

    <!-- Chrome drawn over the map: the corner readouts, docked messages. windowBackground with an alpha,
         because this sits on ground the player is still playing on. Darker than panelBackground on
         purpose: nothing sits behind it but terrain, so it carries the contrast for its own text rather
         than borrowing a window's. The last two digits are the whole point of the role; CC is 80
         percent. Going much lower fails at midday, when the terrain underneath is at its brightest.
         Keep border opaque so the edge holds the panel together. -->
    <hudBackground>#15191DCC</hudBackground>

    <hoverOverlay>#FFFFFF0C</hoverOverlay>
    <pressedOverlay>#FFFFFF1F</pressedOverlay>
    <selectionOverlay>#73BFFF24</selectionOverlay>
  </Gideon.UIFramework.Defs.UIColorPaletteDef>


  <!-- Light Theme -->
  <Gideon.UIFramework.Defs.UIColorPaletteDef ParentName="UIPaletteBase">
    <defName>UIPalette_Light</defName>
    <label>Modern Light</label>
    <description>A light theme. Pale surfaces with dark text and a deeper blue accent.</description>

    <windowBackground>#E8EAED</windowBackground>
    <panelBackground>#F5F6F8</panelBackground>
    <surfaceRaised>#FFFFFF</surfaceRaised>
    <surfaceSunken>#D8DBE0</surfaceSunken>

    <border>#A8B4C4</border>
    <borderFocused>#2F7FD0</borderFocused>

    <textPrimary>#1B1F23</textPrimary>
    <textSecondary>#4E5866</textSecondary>
    <textDisabled>#8A93A0</textDisabled>

    <accent>#2F7FD0</accent>
    <accentMuted>#BBD4EE</accentMuted>

    <!-- Darker than the panel here rather than lighter. The rule is distance from the surface behind it,
         not a direction. -->
    <controlBackgroundFaded>#C9CED6</controlBackgroundFaded>

    <!-- Same 80 percent, over this theme's own window color. -->
    <hudBackground>#E8EAEDCC</hudBackground>

    <hoverOverlay>#0000000C</hoverOverlay>
    <pressedOverlay>#0000001F</pressedOverlay>
    <selectionOverlay>#2F7FD024</selectionOverlay>

    <!-- The twelve role based tab identities and the mods page, deepened for this theme. They live
         on the shared template as their dark values, and a violet picked to read on near black is
         washed out on near white, so each one is restated here rather than inherited. -->
    <tabTheDead>#7A56A8</tabTheDead>
    <tabQuests>#3C6E9E</tabQuests>
    <tabAnimals>#5F7F3D</tabAnimals>
    <tabPower>#2E8076</tabPower>
    <tabGrowing>#8A6F2C</tabGrowing>
    <tabBills>#9A5A41</tabBills>
    <tabPawns>#9A4568</tabPawns>
    <tabHospital>#99458C</tabHospital>
    <tabResearch>#4A4F94</tabResearch>
    <tabFactions>#2B8752</tabFactions>
    <tabHistory>#2C6F7D</tabHistory>
    <pageMods>#4A4F94</pageMods>

    <!-- Same 29 degrees, deepened to a bronze. The dark value's whole argument is that it is far less
         coloured than its neighbours, and that has to survive the theme: 52 points of chroma here against
         the 89 of the bills clay and the 94 of the growing wheat on either side of it. -->
    <tabMechs>#73593F</tabMechs>
  </Gideon.UIFramework.Defs.UIColorPaletteDef>

</Defs>
