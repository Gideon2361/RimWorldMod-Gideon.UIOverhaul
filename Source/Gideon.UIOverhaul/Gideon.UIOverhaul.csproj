<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- RimWorld 1.6 runs on .NET Framework 4.8.1. -->
        <TargetFramework>net481</TargetFramework>
        <!-- Matches the Growing Zones Plus project, so code moves between the two without a language
             barrier. Needs .NET SDK 9 or newer on PATH; SDK 7 rejects the option outright (CS1617). -->
        <LangVersion>13</LangVersion>
        <AssemblyName>Gideon.UIOverhaul</AssemblyName>
        <!-- Gideon, not Gideon.UIOverhaul: the folders supply the rest, giving Gideon.UIFramework for
             the reusable controls and Gideon.UIOverhaul for what consumes them. A root of
             Gideon.UIOverhaul would make the consumer side Gideon.UIOverhaul.UIOverhaul, and would
             bury the framework under the name of one mod that happens to use it. An external
             consumer should not have to name our UI mod to reference the controls. The assembly name
             is unchanged, so the shipped DLL is the same file either way. -->
        <RootNamespace>Gideon</RootNamespace>
        <Product>Gideon's UI Overhaul</Product>
        <Company>Gideon</Company>
        <!-- Kept in step with <modVersion> in About/About.xml, which is the number the player sees.
             Format: RimWorld major.minor, then RimWorld's build number, then this mod's own sequential
             build number. So 1.6.4871.14086 is build 14086 of this mod, against RimWorld 1.6.4871.
             The first three move when the game does.

             THE LAST INCREMENTS ONLY WHEN WORK IS PUSHED TO MAIN. It used to increment on every
             change, and with more than one branch in flight at a time that stopped working: main,
             FontOverhaul and InProgress were each incrementing the same counter on their own, and
             between them they issued 14193 through 14201 twice over. Two different builds wearing
             one number is worse than no number, and every merge turned into a question about which
             of them was really that build.

             So a feature commit on a branch leaves this line alone, however many of them there are.
             The number changes once, when the work reaches main, and that is the build a player can
             be given. A merge into BuildTest does not bump it either: BuildTest exists to try
             branches out together, and what it carries is whatever main last named plus whatever is
             being tested on top. -->
        <!-- Bumped on merge to main only. See the note above before changing this line. -->
        <Version>1.6.4871.14207</Version>

        <!-- bin\Debug rather than bin\Debug\net481, matching where the deploy target looks. -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!-- Nothing but our own assembly belongs in the mod's Assemblies folder: RimWorld loads
             every DLL it finds there, and a stray copy of a game or Harmony assembly conflicts
             with the one already loaded. -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnableDynamicLoading>false</EnableDynamicLoading>

        <!-- SDK-style globbing: every .cs under this folder compiles without being listed. The old
             project kept an explicit <Compile Include> list, which silently drifted from reality. -->
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <!-- Offline tooling, kept in the repo and out of the mod. The glob would otherwise compile both of
             these into the shipped assembly, where neither can ever run.

             BundleProject is the Unity project that bakes the AssetBundle. Its editor script compiles inside
             Unity against UnityEditor, which no mod assembly may reference.

             Baker is the GDI+ atlas baker, a console tool with its own Main. It only ever runs on a developer
             machine, before a build, and its output is the PNG and metrics pairs already committed under
             Fonts/. Compiled in, it put a System.Drawing reference in the assembly manifest of a RimWorld UI
             mod: dead weight in every subscriber's download, and a reference the game would have to resolve on
             Mac and Linux while enumerating our types at startup. Type enumeration that fails to resolve
             throws ReflectionTypeLoadException and takes the whole assembly with it, not just the one type. -->
        <Compile Remove="ThirdParty\Fonts\BundleProject\**\*.cs" />
        <None Remove="ThirdParty\Fonts\BundleProject\**" />
        <Compile Remove="ThirdParty\Fonts\Baker\**\*.cs" />
        <None Remove="ThirdParty\Fonts\Baker\**" />
    </ItemGroup>

    <PropertyGroup>
        <!-- The only machine-specific settings in the project. On this machine
             C:\Program Files (x86)\Steam\steamapps is a junction to D:\Steam\steamapps, so either
             root resolves to the same files; the real path is used so MSBuild does not depend on
             the junction surviving. -->
        <SteamAppsDir>D:\Steam\steamapps</SteamAppsDir>
        <RimWorldManagedDir>$(SteamAppsDir)\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
        <HarmonyAssemblyDir>$(SteamAppsDir)\workshop\content\294100\2009463077\Current\Assemblies</HarmonyAssemblyDir>
    </PropertyGroup>

    <!-- Private=false throughout: these are loaded by the game already and must not be copied
         alongside our DLL. -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Texture2D.LoadImage, for decoding PNG and JPG bytes we have read ourselves. Mod textures
             are otherwise unavailable during a load: ModContentPack.ReloadContent defers all content
             loading to LongEventHandler.ExecuteWhenFinished, which does not run until the long event
             ends. See UIImageLoader. -->
        <!-- UnityEngine.AssetBundle, for the fonts shipped as a bundle. RimWorld loads the bundle itself;
             this is only for fishing the Font assets back out of it. -->
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- UnityEngine.Input, for the mouse-button state a pressed button is drawn from. Legacy is
             the right module: it is the input API RimWorld itself uses. -->
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.AudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UnityWebRequestModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UnityWebRequestAudioModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- RimWorld ships this in its own managed folder and loads it every session, so the music player's
             mp4 and m4a support costs no new dependency and nothing extra in the download: Unity has no AAC
             decoder on the desktop, and NAudio's Media Foundation reader hands those two formats to Windows.
             Private false like every other game reference, so no copy of it lands in Assemblies. -->
        <Reference Include="NAudio">
            <HintPath>$(RimWorldManagedDir)\NAudio.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(HarmonyAssemblyDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="UIFramework\Debug\" />
      <Folder Include="UIFramework\Patches\UIElements\Patches\" />
      <Folder Include="UIFramework\Stages\" />
      <Folder Include="UIOverhaul\Features\GrowZones\" />
      <Folder Include="UIOverhaul\Patches\" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Set false to build without touching the mod folder. -->
        <DeployToModFolder>true</DeployToModFolder>
        <ModAssembliesDir>$(MSBuildProjectDirectory)\..\..\Gideon.UIOverhaul\1.6\Assemblies</ModAssembliesDir>

        <!-- Putting the build into the folder the game actually reads, for testing.

             Needed because of worktrees. This repo now has more than one checkout: main plus a
             worktree per branch in progress. Every checkout has its own Gideon.UIOverhaul mod folder,
             and RimWorld reads exactly one of them, through the symlink at
             Steam\common\RimWorld\Mods\Gideon.UIOverhaul. So a build in a branch worktree deploys
             correctly into that worktree and is still invisible to the game.

             OFF BY DEFAULT, and that is the whole point of it being a separate switch. Building to
             check that the code compiles and deploying to the running game are different intentions,
             and only the second one is allowed to reach outside this checkout. With several branches
             being worked at once, a build that silently took over the game folder would overwrite
             whichever branch's assembly was being play tested at the time.

             Opt in for one build:  msbuild ... -p:DeployToGame=true

             KNOW WHERE THIS WRITES, because the answer changed. The Mods entry is a junction, and it
             now points at the BuildTest worktree's mod folder rather than main's checkout: that was
             the alternative this note used to describe, and it is the arrangement in use since
             2026-08-30.

             What follows from that is that this switch is usually the wrong tool. Branches are merged
             into BuildTest and built there, and an ordinary build in that worktree already lands in
             the folder the game reads, through the junction and with DeployToModFolder alone. Turning
             this one on from any other worktree writes a branch's assembly into BuildTest's checkout,
             where it is tracked, so BuildTest then shows a modified assembly that disagrees with its
             own source and wants reverting.

             Repointing the junction is what to change if the game should read some other worktree.
             Whichever it points at, that checkout is the one whose tracked assembly this target
             overwrites. -->
        <DeployToGame>false</DeployToGame>
        <GameModAssembliesDir>$(SteamAppsDir)\common\RimWorld\Mods\Gideon.UIOverhaul\1.6\Assemblies</GameModAssembliesDir>
    </PropertyGroup>

    <!-- The copy in the mod folder is the mod, so a build lands there directly rather than being
         moved by hand. The assembly only: RimWorld does not read the .pdb, so shipping one is bloat
         in every subscriber's download. It still lands in bin\ for local debugging. -->
    <Target Name="DeployToMod" AfterTargets="Build" Condition="'$(DeployToModFolder)' == 'true'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModAssembliesDir)" />
        <Message Importance="high" Text="Deployed $(TargetFileName) -> $(ModAssembliesDir)" />
    </Target>

    <!-- The assembly only, exactly as above: RimWorld never reads the .pdb, and a stray one in
         Assemblies is bloat at best. The .pdb stays in bin\ where a debugger can still find it. -->
    <Target Name="DeployToGameFolder" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModAssembliesDir)" />
        <Message Importance="high" Text="Deployed $(TargetFileName) -> $(GameModAssembliesDir)" />
        <Message Importance="high" Text="The game will now load this build. This path is a symlink into main's checkout, so main's tracked assembly has changed." />
    </Target>

</Project>
